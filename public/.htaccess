Options -MultiViews
RewriteEngine On

# One public address for the site.
RewriteCond %{HTTP_HOST} ^www\.mementoproduction\.it$ [NC]
RewriteRule ^ https://mementoproduction.it%{REQUEST_URI} [R=301,L,NE]

# Preserve the old combined service URL when the static site replaces Horizons.
# Service taxonomy: permanent redirects, without intermediate hops.
RewriteRule ^home/?$ / [R=301,L,NE]
RewriteRule ^produzione-video-fotografia/?$ /video [R=301,L,NE]
RewriteRule ^social-media/?$ /social [R=301,L,NE]
RewriteRule ^(?:grafica-branding|branding-siti-web)/?$ /grafica [R=301,L,NE]
RewriteRule ^siti-web-ecommerce/?$ /web [R=301,L,NE]

# The prerendered pages live in physical directories (for example /agenzia/index.html).
# Serve their index files internally so Apache/LiteSpeed does not add a trailing slash,
# then permanently canonicalize any already-indexed trailing-slash URL to the slashless form.
RewriteCond %{THE_REQUEST} \s/+[^\s?]+/+[?\s] [NC]
RewriteRule ^(.+)/+$ /$1 [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Hostinger serves this prerendered Angular page while retaining the HTTP 404 status.
ErrorDocument 404 /404
