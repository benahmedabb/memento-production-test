{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memento-assistente",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "ChatQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatQuota"] }],
  "vars": {
    "AI_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://mementoproduction.it,https://www.mementoproduction.it,https://memento-production-test-2.vercel.app"
  },
  "env": {
    "local": {
      "name": "memento-assistente-local",
      "workers_dev": false,
      "vars": { "AI_ENABLED": "false", "ALLOWED_ORIGINS": "http://localhost:4200,http://127.0.0.1:4200" },
      "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "ChatQuota" }] }
    }
  }
}
